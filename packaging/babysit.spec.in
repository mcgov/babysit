# SPDX-License-Identifier: MIT
#
# One spec for Fedora, its relatives, and openSUSE. The differences are a
# package name and two macros that only Fedora defines.
%global toolchain clang
%{!?build_ldflags:%global build_ldflags %{nil}}
%{!?_pkgdocdir:%global _pkgdocdir %{_docdir}/%{name}}

Name:           babysit
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Run a command detached, log it, and return early if it stalls
License:        MIT
URL:            https://gitlab.com/mowws/babysit
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  clang
BuildRequires:  make
BuildRequires:  systemd-rpm-macros
# for %%check
BuildRequires:  bash
BuildRequires:  tar
BuildRequires:  gzip
%if 0%{?suse_version}
BuildRequires:  procps
%else
BuildRequires:  procps-ng
%endif
BuildRequires:  findutils
Requires:       tar
Requires:       gzip

%description
babysit runs a command in the background under a babysitter process, echoes
its output and writes it to a per-process log. It returns early when an
expected line appears, when the command stops producing output, or after a
timeout, and leaves the command running in every case.

babysitd is an optional systemd user service that archives the logs of
past days, packs sooner when the disk fills up and expires old logs.

%prep
%autosetup

%build
%make_build CFLAGS="%{optflags}" LDFLAGS="%{build_ldflags}" PREFIX=%{_prefix}

%install
%make_install PREFIX=%{_prefix} MANDIR=%{_mandir} UNITDIR=%{_userunitdir} \
    DOCDIR=%{_pkgdocdir} CFLAGS="%{optflags}" LDFLAGS="%{build_ldflags}"
rm -f %{buildroot}%{_pkgdocdir}/LICENSE

%check
make test CFLAGS="%{optflags}" LDFLAGS="%{build_ldflags}" PREFIX=%{_prefix}

%post
%systemd_user_post babysitd.service

%preun
%systemd_user_preun babysitd.service

%postun
%systemd_user_postun_with_restart babysitd.service

%files
%license LICENSE
%doc %{_pkgdocdir}
%{_bindir}/babysit
%{_bindir}/babysitd
%{_mandir}/man1/babysit.1*
%{_mandir}/man5/babysit.conf.5*
%{_mandir}/man8/babysitd.8*
%{_userunitdir}/babysitd.service

%changelog
* Sun Nov 15 2026 Matthew G. McGovern <matthew@mcgov.dev> - 0.1.0-1
- Initial package
